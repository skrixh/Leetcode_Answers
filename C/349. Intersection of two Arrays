/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* intersection(int* nums1, int nums1Size, int* nums2, int nums2Size, int* returnSize) {
   
    // Array to track elements present in nums1 (constraint: 0 <= nums[i] <= 1000)
    int lookup[1001] = {0};
    
    // Mark all numbers present in nums1
    for (int i = 0; i < nums1Size; i++) {
        lookup[nums1[i]] = 1;
    }
    
    // Allocate maximum possible memory for the result array
    int minSize = (nums1Size < nums2Size) ? nums1Size : nums2Size;
    int* result = (int*)malloc(minSize * sizeof(int));
    int count = 0;
    
    // Find intersection and handle uniqueness
    for (int i = 0; i < nums2Size; i++) {
        if (lookup[nums2[i]] == 1) {
            result[count] = nums2[i];
            count++;
            lookup[nums2[i]] = 0; // Mark as 0 to ensure uniqueness in the output
        }
    }
    
    *returnSize = count;
    return result;


}