int compare(const void* a, const void* b) {
    long long valA = *(const long long*)a;
    long long valB = *(const long long*)b;
    if (valA < valB) return -1;
    if (valA > valB) return 1;
    return 0;
}

long long maxAlternatingSum(int* nums, int numsSize) {
    long long* squares = (long long*)malloc(numsSize * sizeof(long long));
    
    for (int i = 0; i < numsSize; i++) {
        squares[i] = (long long)nums[i] * nums[i];
    }
    
    // Sort array of squares in ascending order
    qsort(squares, numsSize, sizeof(long long), compare);
    
    long long totalScore = 0;
    int half = numsSize / 2;
    
    // Subtract the smallest floor(n/2) squares
    for (int i = 0; i < half; i++) {
        totalScore -= squares[i];
    }
    
    // Add the remaining largest ceil(n/2) squares
    for (int i = half; i < numsSize; i++) {
        totalScore += squares[i];
    }
    
    free(squares);
    return totalScore;
}
