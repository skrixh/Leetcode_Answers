char* longestCommonPrefix(char** strs, int strsSize) {
    


    // Edge case: if the array is empty, return an empty string
    if (strsSize == 0 || strs == NULL) {
        char* empty = (char*)malloc(sizeof(char));
        empty[0] = '\0';
        return empty;
    }

    // Use the first string as a reference point
    char* first_str = strs[0];
    int len = strlen(first_str);

    // Iterate through every character position of the first string
    for (int i = 0; i < len; i++) {
        char current_char = first_str[i];

        // Compare this character with the same position in all other strings
        for (int j = 1; j < strsSize; j++) {
            // Stop if the current string is shorter, or if a character mismatch occurs
            if (strs[j][i] == '\0' || strs[j][i] != current_char) {
                // Allocate space for the prefix up to index i + null-terminator
                char* result = (char*)malloc((i + 1) * sizeof(char));
                strncpy(result, first_str, i);
                result[i] = '\0';
                return result;
            }
        }
    }

    // If the loop completes, the entire first string is the common prefix
    char* result = (char*)malloc((len + 1) * sizeof(char));
    strcpy(result, first_str);
    return result;
}

