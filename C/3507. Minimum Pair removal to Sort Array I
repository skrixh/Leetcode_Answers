int minimumPairRemoval(int* nums, int numsSize) {
    int ops = 0;

    while (1) {
        // Check if sorted
        bool sorted = true;
        for (int i = 0; i < numsSize - 1; i++) {
            if (nums[i] > nums[i + 1]) {
                sorted = false;
                break;
            }
        }
        if (sorted) break;

        // Find minimum adjacent pair sum
        int minSum = nums[0] + nums[1];
        int minIdx = 0;
        for (int i = 1; i < numsSize - 1; i++) {
            int pairSum = nums[i] + nums[i + 1];
            if (pairSum < minSum) {
                minSum = pairSum;
                minIdx = i;
            }
        }

        // Merge adjacent pair in-place
        nums[minIdx] = minSum;
        for (int i = minIdx + 1; i < numsSize - 1; i++) {
            nums[i] = nums[i + 1];
        }
        numsSize--;
        ops++;
    }

    return ops;
}
